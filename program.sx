import math
loop{
num1 = 0
num2 = 0
op = ""
show("WELCOME")
ask("Enter number 1,2 & op: ">>num1,num2,op)
if op == "+": show(f"Answer: {num1 + num2}")
elf op == "-": show(f"Answer: {num1 - num2}")
elf op == "/": show(f"Answer: {num1 / num2}")
elf op == "*": show(f"Answer: {num1 * num2}")
elf op == "sqrt" {
     show(f"Answer when add: {math.sqrt(num1 + num2)}")
     show(f"Answer when minus: {math.sqrt(num1 - num2)}")
     show(f"Answer when divide: {math.sqrt(num1 / num2)}")
     show(f"Answer when times: {math.sqrt(num1 * num2)}")
}
els {
     show("Wrong, program ended") sloop()
}
}

